{
  "name": "@farmx/support-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "node --watch --import tsx --env-file-if-exists=../../.env src/server.ts",
    "db:seed": "node --import tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@farmx/common": "workspace:*",
    "@farmx/database": "workspace:*",
    "@farmx/infra": "workspace:*",
    "@fastify/awilix": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "amqplib": "^0.10.9",
    "awilix": "catalog:",
    "bullmq": "^5.66.0",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "ioredis": "catalog:",
    "joi": "catalog:",
    "joi-to-swagger": "catalog:",
    "luxon": "^3.7.2",
    "pino": "catalog:",
    "pino-pretty": "catalog:"
  },
  "devDependencies": {
    "@farmx/tsconfig": "workspace:*",
    "@types/luxon": "^3.7.1",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.22.2"
  }
}

{
  "name": "@farmx/farm-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "node --watch --import tsx --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:seed": "node --import tsx --env-file-if-exists=../../.env scripts/seed-geo.ts"
  },
  "dependencies": {
    "@farmx/common": "workspace:*",
    "@farmx/database": "workspace:*",
    "@farmx/infra": "workspace:*",
    "@fastify/awilix": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "awilix": "catalog:",
    "bullmq": "^5.66.0",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "ioredis": "catalog:",
    "joi": "catalog:",
    "joi-to-swagger": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:"
  },
  "devDependencies": {
    "@farmx/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

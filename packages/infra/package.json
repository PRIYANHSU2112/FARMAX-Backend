{
  "name": "@farmx/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Infrastructure clients: redis (cache, lock, keys) and events (RabbitMQ envelope + contracts). Database code lives in @farmx/database. Source-only (no build).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./redis": "./src/redis/index.ts",
    "./events": "./src/events/index.ts",
    "./rabbitmq": "./src/events/rabbitmq.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@farmx/common": "workspace:*",
    "amqplib": "^0.10.9",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@farmx/tsconfig": "workspace:*",
    "@types/amqplib": "^0.10.7",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

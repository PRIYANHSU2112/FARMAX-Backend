// catalog-service feature: categories. Arbitrary-depth tree = adjacency list (`parentId`, the
// source of truth) + materialized path (`path`, for one-query subtree/ancestor reads) — D-28.
// Only services/catalog-service/src/features/categories/*.repository.ts queries this model.

model Category {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// null = root node.
  parentId        String?   @db.Uuid
  /// Ids from the root down to this node: `/<rootId>/<childId>/<id>/`. Subtree = `path LIKE '<path>%'`
  /// (text_pattern_ops index). Rewritten for the whole subtree on move, in one UPDATE.
  path            String
  /// 0 = root. Max depth is CATALOG_MAX_CATEGORY_DEPTH (guard rail, not a schema limit).
  depth           Int       @db.SmallInt
  name            String    @db.VarChar(80)
  /// Telugu display name (storefront language toggle, search).
  nameTe          String?   @db.VarChar(120)
  /// URL key, unique among live categories (partial unique index in the migration).
  slug            String    @db.VarChar(100)
  description     String?   @db.VarChar(1000)
  /// Public media-service URL.
  imageUrl        String?   @db.VarChar(500)
  /// Sibling order (ascending), then name.
  sortOrder       Int       @default(0)
  /// false hides this node AND its whole subtree (and their products) from the storefront.
  isActive        Boolean   @default(true)
  version         Int       @default(0)
  createdByUserId String    @db.Uuid
  updatedByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  @@index([parentId, sortOrder])
  @@map("categories")
}

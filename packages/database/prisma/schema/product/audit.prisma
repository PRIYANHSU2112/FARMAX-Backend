// product-service feature: audit. Same shape as catalog_audit_log; append-only (D-22).

model ProductAuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String   @db.Uuid
  /// product.create, product.update, product.status, variant.*, attribute.*, lookup.*, …
  action      String   @db.VarChar(60)
  /// product, variant, attribute, compliance_profile, lookup
  targetType  String   @db.VarChar(30)
  targetId    String   @db.VarChar(64)
  before      Json?
  after       Json?
  reason      String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  requestId   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("product_audit_log")
}

// product-service feature: reviews. Verified-purchase product reviews, helpful votes, reports and
// per-product rating summaries. Eligibility is a projection of order.delivered.v1 (ids only).

enum ReviewStatus {
  /// Flagged by the auto-moderation rules (or edited into a flag); waits for an admin.
  PENDING
  PUBLISHED
  REJECTED
  /// Taken down by an admin or auto-hidden after too many reports.
  HIDDEN
}

enum ReviewReportReason {
  SPAM
  ABUSIVE
  OFF_TOPIC
  FAKE
  PERSONAL_INFO
  OTHER
}

enum ReviewReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

/// One delivered (order, product) a customer may review. Written only by the order.delivered.v1 consumer.
model ReviewEligibility {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  productId   String   @db.Uuid
  variantId   String   @db.Uuid
  orderId     String   @db.Uuid
  orderNo     String   @db.VarChar(20)
  deliveredAt DateTime
  /// Set while a live review uses this purchase; cleared when that review is deleted.
  reviewId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([userId, productId, orderId])
  @@index([userId, reviewId, deliveredAt])
  @@map("review_eligibilities")
}

model ProductReview {
  id                String       @id @default(uuid(7)) @db.Uuid
  productId         String       @db.Uuid
  variantId         String       @db.Uuid
  orderId           String       @db.Uuid
  userId            String       @db.Uuid
  /// Masked snapshot, e.g. "Ramesh K." (never the full name or contact).
  authorName        String       @db.VarChar(60)
  rating            Int          @db.SmallInt
  title             String?      @db.VarChar(120)
  body              String?      @db.VarChar(2000)
  /// [{ mediaId, url }] — at most 5, media-service URLs only.
  images            Json         @default("[]")
  hasImages         Boolean      @default(false)
  status            ReviewStatus
  /// Auto-moderation reasons (LINK, PHONE, EMAIL, BANNED_WORD, SHOUTING, REPEATED, IMAGES, REPORTS).
  flags             String[]     @default([])
  moderationReason  String?      @db.VarChar(500)
  helpfulCount      Int          @default(0)
  reportCount       Int          @default(0)
  openReportCount   Int          @default(0)
  editCount         Int          @default(0) @db.SmallInt
  publishedAt       DateTime?
  moderatedByUserId String?      @db.Uuid
  moderatedAt       DateTime?
  version           Int          @default(0)
  /// title + body + authorName (service-maintained) for admin search.
  searchText        String       @default("")
  /// GENERATED ALWAYS AS to_tsvector('simple', searchText) STORED (migration SQL).
  searchVector      Unsupported("tsvector")?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  votes   ReviewVote[]
  reports ReviewReport[]

  // One live review per (userId, productId): partial unique index in the migration SQL.
  @@index([productId, status, createdAt(sort: Desc), id])
  @@index([productId, status, helpfulCount(sort: Desc), id])
  @@index([productId, status, rating, id])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("product_reviews")
}

model ReviewVote {
  reviewId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_votes")
}

model ReviewReport {
  id               String             @id @default(uuid(7)) @db.Uuid
  reviewId         String             @db.Uuid
  userId           String             @db.Uuid
  reason           ReviewReportReason
  note             String?            @db.VarChar(500)
  status           ReviewReportStatus @default(OPEN)
  resolvedByUserId String?            @db.Uuid
  resolvedAt       DateTime?
  resolutionNote   String?            @db.VarChar(500)
  createdAt        DateTime           @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([status, createdAt])
  @@map("review_reports")
}

/// Running totals over PUBLISHED reviews only; updated by deltas in the review transaction.
model ProductRatingSummary {
  productId   String   @id @db.Uuid
  ratingCount Int      @default(0)
  ratingSum   Int      @default(0)
  ratingAvg   Decimal  @default(0) @db.Decimal(3, 2)
  star1       Int      @default(0)
  star2       Int      @default(0)
  star3       Int      @default(0)
  star4       Int      @default(0)
  star5       Int      @default(0)
  textCount   Int      @default(0)
  imageCount  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("product_rating_summaries")
}

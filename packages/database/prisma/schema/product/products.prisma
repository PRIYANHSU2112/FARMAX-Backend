// product-service feature: products. Products, variants, ingredients, media, the dynamic master
// lookups they reference (one feature, so the FKs below stay inside it), the read-only price and
// availability projections (written only by event consumers) and the category/brand reference
// blocks used by the safe-delete protocol. categoryId / brandId are plain uuids (catalog-service, D-21).
// Only services/product-service/src/features/products/*.repository.ts queries these models.

enum ProductLookupGroup {
  DOSAGE_FORM
  ROUTE
  SPECIES
  UNIT
  /// Flock / production stages. Codes are stored in Product.productionStages; meta.aliases maps legacy text.
  FLOCK_STAGE
}

enum DrugSchedule {
  OTC
  G
  H
  H1
  X
}

enum RegistrationAuthority {
  CDSCO
  STATE
}

/// Logistics PRD temperature classes (CC-FRZ is out of Phase 1 for transport, kept for the catalogue).
enum TemperatureClass {
  AMB
  AMB_CTL
  CC_REF
  CC_FRZ
  HAZ
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  DISCONTINUED
}

enum ProductMediaKind {
  IMAGE
  DOCUMENT
}

enum ProductDocType {
  TDS
  SDS
  MSDS
  LEAFLET
  PACKAGE_INSERT
  LABEL
  CERTIFICATE
}

enum ProductReferenceType {
  CATEGORY
  BRAND
}

/// Admin-managed master values (dosage forms, routes, species, units). Never hard-coded enums.
model ProductLookup {
  id              String             @id @default(uuid(7)) @db.Uuid
  group           ProductLookupGroup
  /// Upper-case code, unique per group among live rows (partial unique index in the migration).
  code            String             @db.VarChar(40)
  label           String             @db.VarChar(80)
  description     String?            @db.VarChar(300)
  /// SPECIES: { producesMeat, producesEggs } drive the withdrawal rules.
  meta            Json               @default("{}")
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  version         Int                @default(0)
  createdByUserId String             @db.Uuid
  updatedByUserId String             @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  dosageFormOf    Product[]           @relation("ProductDosageForm")
  routeOf         ProductRoute[]
  speciesOf       ProductSpecies[]
  ingredientUnit  ProductIngredient[] @relation("IngredientUnit")
  ingredientPer   ProductIngredient[] @relation("IngredientPerUnit")
  variantPackUnit ProductVariant[]

  @@index([group, isActive, sortOrder])
  @@map("product_lookups")
}

model Product {
  id                     String                   @id @default(uuid(7)) @db.Uuid
  name                   String                   @db.VarChar(160)
  /// URL key, unique among live products.
  slug                   String                   @db.VarChar(180)
  /// Human code `FXP-000123` from the `product_code_seq` sequence; unique among live products.
  productCode            String                   @db.VarChar(20)
  shortDescription       String?                  @db.VarChar(300)
  description            String?
  /// catalog-service category (any depth) — plain uuid, no FK (D-21).
  categoryId             String                   @db.Uuid
  /// catalog-service brand — plain uuid + name snapshot (synced by catalog.brand.updated.v1).
  brandId                String                   @db.Uuid
  brandName              String                   @db.VarChar(80)
  genericName            String?                  @db.VarChar(200)
  dosageFormId           String?                  @db.Uuid
  productionStages       String[]                 @default([])
  indications            String?
  dosageInstructions     String?
  contraindications      String?
  sideEffects            String?
  precautions            String?
  /// 0 = no withdrawal; null = not stated.
  withdrawalMeatDays     Int?                     @db.SmallInt
  withdrawalEggDays      Int?                     @db.SmallInt
  manufacturerName       String?                  @db.VarChar(160)
  manufacturerAddress    String?                  @db.VarChar(500)
  marketerName           String?                  @db.VarChar(160)
  drugSchedule           DrugSchedule             @default(OTC)
  registrationAuthority  RegistrationAuthority?
  registrationNo         String?                  @db.VarChar(60)
  drugLicenseNo          String?                  @db.VarChar(60)
  manufacturingLicenseNo String?                  @db.VarChar(60)
  isPrescriptionRequired Boolean                  @default(false)
  isVetConsultRequired   Boolean                  @default(false)
  /// FR-RX-15: antimicrobial prescriptions are reportable.
  isAntimicrobial        Boolean                  @default(false)
  temperatureClass       TemperatureClass         @default(AMB)
  storageMinTempC        Decimal?                 @db.Decimal(4, 1)
  storageMaxTempC        Decimal?                 @db.Decimal(4, 1)
  isFreezeSensitive      Boolean                  @default(false)
  isLightSensitive       Boolean                  @default(false)
  isHumiditySensitive    Boolean                  @default(false)
  storageInstructions    String?                  @db.VarChar(500)
  shelfLifeMonths        Int?                     @db.SmallInt
  /// GHS hazard class and UN number (temperatureClass HAZ).
  hazardClass            String?                  @db.VarChar(40)
  unNumber               String?                  @db.VarChar(10)
  hsnCode                String                   @db.VarChar(8)
  gstRate                Decimal                  @db.Decimal(5, 2)
  countryOfOrigin        String?                  @db.Char(2)
  tags                   String[]                 @default([])
  seoTitle               String?                  @db.VarChar(70)
  seoDescription         String?                  @db.VarChar(160)
  /// Values of the category's dynamic attributes (validated against the inherited definitions).
  attributes             Json                     @default("{}")
  isFeatured             Boolean                  @default(false)
  isActive               Boolean                  @default(true)
  status                 ProductStatus            @default(DRAFT)
  submittedByUserId      String?                  @db.Uuid
  submittedAt            DateTime?
  publishedByUserId      String?                  @db.Uuid
  publishedAt            DateTime?
  /// Service-maintained: name, generic, ingredients, brand, tags, code (rebuilt in the write tx).
  searchText             String                   @default("")
  /// GENERATED ALWAYS AS to_tsvector('simple', searchText) STORED (migration SQL).
  searchVector           Unsupported("tsvector")?
  /// Derived from the price projection (filters/sort only; pricing-service owns prices).
  minPrice               Decimal?                 @db.Decimal(14, 2)
  maxPrice               Decimal?                 @db.Decimal(14, 2)
  /// Best discount % across active variants ((mrp − sellingPrice) / mrp), for the discount sort.
  maxDiscountPercent     Decimal?                 @db.Decimal(5, 2)
  /// Derived from product_rating_summaries (PUBLISHED reviews only); null = no ratings yet.
  ratingAvg              Decimal?                 @db.Decimal(3, 2)
  ratingCount            Int                      @default(0)
  version                Int                      @default(0)
  createdByUserId        String                   @db.Uuid
  updatedByUserId        String                   @db.Uuid
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?

  dosageForm  ProductLookup?      @relation("ProductDosageForm", fields: [dosageFormId], references: [id], onDelete: Restrict)
  routes      ProductRoute[]
  species     ProductSpecies[]
  ingredients ProductIngredient[]
  variants    ProductVariant[]
  media       ProductMedia[]
  diseases    ProductDisease[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status, isActive, isFeatured])
  @@index([status, isActive, ratingAvg])
  @@index([shelfLifeMonths])
  @@map("products")
}

/// "Shop by Problem": admin-managed disease / problem master. Slug and name are unique among live
/// rows only (partial unique indexes in the migration), so a deleted disease's slug can be reused.
model Disease {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    @db.VarChar(80)
  slug            String    @db.VarChar(100)
  description     String?   @db.VarChar(500)
  iconUrl         String?   @db.VarChar(500)
  /// media-service asset id, when uploaded through it.
  iconMediaId     String?   @db.Uuid
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  version         Int       @default(0)
  createdByUserId String    @db.Uuid
  updatedByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  products ProductDisease[]

  @@index([isActive, sortOrder])
  @@map("diseases")
}

/// Product ↔ disease link. Links of a soft-deleted disease are kept as history.
model ProductDisease {
  productId String @db.Uuid
  diseaseId String @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  disease Disease @relation(fields: [diseaseId], references: [id], onDelete: Restrict)

  @@id([productId, diseaseId])
  @@index([diseaseId])
  @@map("product_diseases")
}

model ProductRoute {
  productId String @db.Uuid
  lookupId  String @db.Uuid

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  lookup  ProductLookup @relation(fields: [lookupId], references: [id], onDelete: Restrict)

  @@id([productId, lookupId])
  @@index([lookupId])
  @@map("product_routes")
}

model ProductSpecies {
  productId String @db.Uuid
  lookupId  String @db.Uuid

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  lookup  ProductLookup @relation(fields: [lookupId], references: [id], onDelete: Restrict)

  @@id([productId, lookupId])
  @@index([lookupId])
  @@map("product_species")
}

/// Active ingredient (molecule) with strength, e.g. Enrofloxacin 100 mg per 1 ml.
model ProductIngredient {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @db.Uuid
  name        String   @db.VarChar(120)
  strength    Decimal  @db.Decimal(14, 4)
  unitId      String   @db.Uuid
  perQuantity Decimal? @db.Decimal(14, 4)
  perUnitId   String?  @db.Uuid
  sortOrder   Int      @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    ProductLookup  @relation("IngredientUnit", fields: [unitId], references: [id], onDelete: Restrict)
  perUnit ProductLookup? @relation("IngredientPerUnit", fields: [perUnitId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@map("product_ingredients")
}

/// Pack-size / strength variant. No stock (inventory-service) and no selling price (pricing-service).
model ProductVariant {
  id              String    @id @default(uuid(7)) @db.Uuid
  productId       String    @db.Uuid
  /// Unique among live variants.
  sku             String    @db.VarChar(40)
  /// GS1 GTIN / barcode; unique among live variants when set.
  barcode         String?   @db.VarChar(20)
  name            String    @db.VarChar(80)
  packSize        Decimal   @db.Decimal(12, 3)
  packUnitId      String    @db.Uuid
  unitsPerPack    Int       @default(1)
  /// Legal Metrology MRP (incl. taxes).
  mrp             Decimal   @db.Decimal(14, 2)
  minOrderQty     Int       @default(1)
  maxOrderQty     Int?
  /// Retail pack that B2C buyers may purchase (PRD p15).
  isB2cEligible   Boolean   @default(false)
  /// Gross weight in grams of ONE sellable pack (the unit inventory counts); null = not set.
  /// Drives warehouse capacity in kg (D-56); unknown weights are excluded, never guessed.
  weightGrams     Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  hsnCode         String?   @db.VarChar(8)
  gstRate         Decimal?  @db.Decimal(5, 2)
  /// Exactly one live default per product (service invariant + partial unique index).
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  version         Int       @default(0)
  createdByUserId String    @db.Uuid
  updatedByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  product          Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  packUnit         ProductLookup             @relation(fields: [packUnitId], references: [id], onDelete: Restrict)
  media            ProductMedia[]
  price            VariantPriceProjection?
  availability     VariantAvailability?
  nodeAvailability VariantNodeAvailability[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

model ProductMedia {
  id              String           @id @default(uuid(7)) @db.Uuid
  productId       String           @db.Uuid
  /// null = product-level; set = variant-specific image/document.
  variantId       String?          @db.Uuid
  kind            ProductMediaKind
  docType         ProductDocType?
  url             String           @db.VarChar(500)
  /// media-service asset id, when uploaded through it.
  mediaId         String?          @db.Uuid
  title           String?          @db.VarChar(120)
  sortOrder       Int              @default(0)
  isPrimary       Boolean          @default(false)
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, kind, sortOrder])
  @@map("product_media")
}

/// Read-only projection of pricing-service (pricing.price.changed.v1). Never written by an API.
model VariantPriceProjection {
  variantId     String   @id @db.Uuid
  sellingPrice  Decimal  @db.Decimal(14, 2)
  currency      String   @default("INR") @db.Char(3)
  effectiveFrom DateTime
  sourceEventId String   @db.Uuid
  /// Monotonic version from the producer; an older event never overwrites a newer one.
  sourceVersion BigInt
  updatedAt     DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_price_projections")
}

/// Read-only projection of inventory-service (inventory.availability.changed.v1).
model VariantAvailability {
  variantId     String   @id @db.Uuid
  availableQty  Int
  inStock       Boolean
  lowStock      Boolean
  sourceVersion BigInt
  updatedAt     DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([inStock])
  @@map("variant_availability")
}

/// Per-node (inventory warehouse) sellable stock of one variant, from availability_changed.v1
/// `byNode`. Replaced whole per variant under the same sourceVersion guard as VariantAvailability.
/// Powers "In stock at <node>" (storefront `nodeId` + `inStock=true`).
model VariantNodeAvailability {
  variantId     String   @db.Uuid
  nodeId        String   @db.Uuid
  availableQty  Int
  inStock       Boolean
  sourceVersion BigInt
  updatedAt     DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, nodeId])
  @@index([nodeId, inStock, variantId])
  @@map("variant_node_availability")
}

/// A catalog category/brand being deleted: no product may be assigned to it (safe-delete protocol).
model ProductReferenceBlock {
  id        String               @id @default(uuid(7)) @db.Uuid
  refType   ProductReferenceType
  refId     String               @db.Uuid
  createdAt DateTime             @default(now())

  @@unique([refType, refId])
  @@map("product_reference_blocks")
}

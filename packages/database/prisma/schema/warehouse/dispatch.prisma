// warehouse-service feature: dispatch (D-57b Phase 4a). Route master, carriers, vehicles, drivers,
// trips (many shipments ↔ many trips), GPS pings (monthly range partitions, raw SQL) and the
// weighbridge. Its own module boundary (§2a.9): it stores shipment ids, fulfilment stores trip ids.

enum WmsCarrierType {
  OWN_FLEET
  THREE_PL
}

enum WmsFleetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum WmsKycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WmsTripType {
  STANDARD
  BULK
}

enum WmsTripStatus {
  PLANNED
  LOADING
  DEPARTED
  COMPLETED
  CANCELLED
}

/// Named delivery route ("Route #8 – South Corridor"); a shipment gets the route whose PIN list
/// holds its delivery PIN.
model WmsDispatchRoute {
  id           String   @id @default(uuid(7)) @db.Uuid
  warehouseId  String   @db.Uuid
  code         String   @db.VarChar(20)
  name         String   @db.VarChar(120)
  corridorName String?  @db.VarChar(120)
  pinCodes     String[]
  districts    String[]
  /// [{name, lat, lng}] in driving order.
  stops        Json     @default("[]")
  isActive     Boolean  @default(true)
  version      Int      @default(0)
  createdBy    String?  @db.Uuid
  updatedBy    String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([warehouseId, code])
  @@map("warehouse_dispatch_routes")
}

model WmsCarrier {
  id        String         @id @default(uuid(7)) @db.Uuid
  name      String         @db.VarChar(120)
  type      WmsCarrierType
  phone     String?        @db.VarChar(20)
  gstin     String?        @db.VarChar(15)
  status    WmsFleetStatus @default(ACTIVE)
  version   Int            @default(0)
  createdBy String?        @db.Uuid
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("warehouse_dispatch_carriers")
}

model WmsVehicle {
  id             String          @id @default(uuid(7)) @db.Uuid
  regNo          String          @unique @db.VarChar(20)
  carrierId      String?         @db.Uuid
  warehouseId    String?         @db.Uuid
  vehicleClass   WmsVehicleClass
  capacityKg     Decimal         @db.Decimal(10, 2)
  refrigerated   Boolean         @default(false)
  sensorsEnabled Boolean         @default(false)
  status         WmsFleetStatus  @default(ACTIVE)
  version        Int             @default(0)
  createdBy      String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([warehouseId, status])
  @@map("warehouse_dispatch_vehicles")
}

model WmsDriver {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// Own-fleet driver with a staff account; null for 3PL drivers (trip links, §2a.8).
  userId      String?        @db.Uuid
  name        String         @db.VarChar(120)
  phone       String         @db.VarChar(20)
  licenceNo   String?        @db.VarChar(30)
  kycStatus   WmsKycStatus   @default(PENDING)
  carrierId   String?        @db.Uuid
  warehouseId String?        @db.Uuid
  status      WmsFleetStatus @default(ACTIVE)
  version     Int            @default(0)
  createdBy   String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([warehouseId, status])
  @@map("warehouse_dispatch_drivers")
}

model WmsTrip {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// TRP-YYMM-####
  tripNo            String        @unique @db.VarChar(20)
  warehouseId       String        @db.Uuid
  type              WmsTripType   @default(STANDARD)
  status            WmsTripStatus @default(PLANNED)
  vehicleId         String?       @db.Uuid
  driverId          String?       @db.Uuid
  carrierId         String?       @db.Uuid
  routeId           String?       @db.Uuid
  dockDoorId        String?       @db.Uuid
  dockBookingId     String?       @db.Uuid
  /// [{name, lat, lng, shipmentId?}] planned stops (route stops + drops).
  routeStops        Json          @default("[]")
  loadedPct         Int           @default(0)
  plannedDepartAt   DateTime?
  gateInAt          DateTime?
  loadingStartedAt  DateTime?
  departedAt        DateTime?
  etaAt             DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  grossKg           Decimal?      @db.Decimal(12, 2)
  tareKg            Decimal?      @db.Decimal(12, 2)
  netKg             Decimal?      @db.Decimal(12, 2)
  weighSlipNo       String?       @db.VarChar(40)
  weighSlipMediaKey String?       @db.VarChar(300)
  weighedAt         DateTime?
  weightVerified    Boolean?
  lastPingAt        DateTime?
  lastLat           Decimal?      @db.Decimal(9, 6)
  lastLng           Decimal?      @db.Decimal(9, 6)
  lastSpeedKmh      Decimal?      @db.Decimal(6, 1)
  remainingKm       Decimal?      @db.Decimal(8, 1)
  network           String?       @db.VarChar(10)
  note              String?       @db.VarChar(500)
  createdBy         String?       @db.Uuid
  version           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  shipments WmsTripShipment[]

  @@index([warehouseId, status, plannedDepartAt(sort: Desc)])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@map("warehouse_dispatch_trips")
}

/// Many-to-many: one consignment may use two trucks; one truck carries many consignments.
model WmsTripShipment {
  tripId     String   @db.Uuid
  shipmentId String   @db.Uuid
  seq        Int
  plannedKg  Decimal? @db.Decimal(12, 2)
  loadedKg   Decimal? @db.Decimal(12, 2)
  trip       WmsTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([tripId, shipmentId])
  @@index([shipmentId])
  @@map("warehouse_dispatch_trip_shipments")
}

/// GPS pings: monthly range partitions on `at` (created by the migration / ping-retention job);
/// ≤ 1 stored per 30 s per trip; downsampled after 7 days; dropped after 90 days.
model WmsTripPing {
  tripId      String   @db.Uuid
  at          DateTime
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  speedKmh    Decimal? @db.Decimal(6, 1)
  remainingKm Decimal? @db.Decimal(8, 1)
  network     String?  @db.VarChar(10)
  source      String   @db.VarChar(12)

  @@id([tripId, at])
  @@map("warehouse_dispatch_trip_pings")
}

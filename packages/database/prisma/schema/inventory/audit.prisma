// inventory-service feature: audit. Same shape as order_audit_log; append-only (D-22).

model InventoryAuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for system actors (expiry job, internal service calls).
  actorUserId String?  @db.Uuid
  /// warehouse.create, stock.receive, adjustment.approve, reservation.release, …
  action      String   @db.VarChar(60)
  /// warehouse, settings, stock_level, operation, reservation
  targetType  String   @db.VarChar(30)
  targetId    String   @db.VarChar(64)
  before      Json?
  after       Json?
  reason      String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  requestId   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("inventory_audit_log")
}

// user-service feature: audit. Same shape as catalog_audit_log; append-only (D-22). Records the
// customer's own address changes (actor = the customer) for support and disputes.

model UserAuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String   @db.Uuid
  /// address.create, address.update, address.default, address.delete
  action      String   @db.VarChar(60)
  /// address
  targetType  String   @db.VarChar(30)
  targetId    String   @db.VarChar(64)
  before      Json?
  after       Json?
  reason      String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  requestId   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("user_audit_log")
}

{
  "name": "@farmx/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared building blocks for every service: config, logger, errors, response, types, middleware, server. Source-only (no build): consumers compile it (tsx in dev, tsup bundle in services).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./logger": "./src/logger/index.ts",
    "./errors": "./src/errors/index.ts",
    "./response": "./src/response/index.ts",
    "./types": "./src/types/index.ts",
    "./middleware": "./src/middleware/index.ts",
    "./server": "./src/server/index.ts",
    "./auth": "./src/auth/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/awilix": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "awilix": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "joi": "catalog:",
    "joi-to-swagger": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:"
  },
  "devDependencies": {
    "@farmx/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

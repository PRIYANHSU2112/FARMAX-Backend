# ─────────────────────────────────────────────────────────────────────────────
# Added 2026-11-25 from .env.example: only keys that were missing. Everything above is unchanged.
# Template keys with an EMPTY value stay commented out (an empty string fails config validation and
# stops the service): fill in the value, then remove the leading "# ".
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
APP_ENV=local

# ── Postgres: ONE shared database for every service ──
POSTGRES_USER=farmx
POSTGRES_PASSWORD=farmx
POSTGRES_DB=farmx

# ── Redis ──
REDIS_CACHE_PORT=6379
REDIS_QUEUE_PORT=6380
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# ── RabbitMQ ──
RABBITMQ_USER=farmx
RABBITMQ_PASSWORD=farmx
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── auth-service: tokens, OTP, MFA (generate with: pnpm --filter @farmx/auth-service keys:generate) ──
MFA_ENFORCED=false
JWT_ISSUER=farmx-auth
JWT_AUDIENCE=farmx
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=12
CUSTOMER_SESSION_IDLE_DAYS=30
CUSTOMER_SESSION_MAX_DAYS=90

# ── media-service: uploads to DigitalOcean Spaces (S3 API) ──
# MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_CONCURRENT_TRANSCODES=2
# FFMPEG_PATH=

# ── API docs: ONE Swagger UI for every service, on the gateway (D-29) ──
DOCS_ENABLED=true
DOCS_SERVER_LOCAL_URL=http://localhost:3090/v1/auth
DOCS_SERVER_PROD_URL=https://api.farmx.in/v1/auth


# Copy to .env (gitignored). Defaults match infra/docker/compose.yml — start it with `pnpm infra:up`.
# Every service and packages/database load this file. Shell variables win over it.

# ── Runtime ──
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# ── Postgres: ONE shared database for every service ──
POSTGRES_USER=farmx
POSTGRES_PASSWORD=farmx
POSTGRES_PORT=5432
POSTGRES_DB=farmx
# The single connection string used by every service (via @farmx/database).
DATABASE_URL=postgresql://farmx:farmx@localhost:5432/farmx

# ── Redis ──
REDIS_CACHE_PORT=6379
REDIS_QUEUE_PORT=6380
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# ── RabbitMQ ──
RABBITMQ_USER=farmx
RABBITMQ_PASSWORD=farmx
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://farmx:farmx@localhost:5672

# ── auth-service: tokens, OTP, MFA (generate with: pnpm --filter @farmx/auth-service keys:generate) ──
# Required when APP_ENV=dev or prod. Local runs without them use EPHEMERAL keys (logged warning).
JWT_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
OTP_PEPPER=
MFA_ENCRYPTION_KEY=
# false (default) = MFA is opt-in: a user/admin turns it on from settings (/me/mfa/totp/enroll →
# /confirm) and from then on every login asks for the 6-digit code. true = accounts/roles flagged
# mfaRequired (e.g. Super Admin) must set up MFA before they get a full token (D-30).
MFA_ENFORCED=false
JWT_ISSUER=farmx-auth
JWT_AUDIENCE=farmx
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=12
CUSTOMER_SESSION_IDLE_DAYS=30
CUSTOMER_SESSION_MAX_DAYS=90
# console = log OTPs instead of sending (local/dev only; refused in prod)
SMS_PROVIDER=console

# ── media-service: uploads to DigitalOcean Spaces (S3 API) ──
AWS_ENDPOINT=https://blr1.digitaloceanspaces.com
AWS_REGION=blr1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Object key prefix: dev | prod → <folder>/<uuidv7>.<ext>
BUCKET_FOLDER_PATH=dev
# Optional CDN base, e.g. https://<bucket>.blr1.cdn.digitaloceanspaces.com (default: bucket origin)
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_CONCURRENT_TRANSCODES=2
# Optional: use a system ffmpeg instead of the bundled ffmpeg-static binary
FFMPEG_PATH=
# media-service verifies access tokens with auth-service's JWT_PUBLIC_KEY + JWT_KEY_ID (above).

# ── API docs: ONE Swagger UI for every service, on the gateway (D-29) ──
#   http://localhost:3090/api-docs   (Postman: http://localhost:3090/api-docs.json)
# Each service only publishes its spec at <service>/api-docs.json; the gateway merges them.
# Default: on, except APP_ENV=prod. Set false to turn off anywhere.
DOCS_ENABLED=true
# auth-service spec "servers" (only used when its spec is read on its own).
DOCS_SERVER_LOCAL_URL=http://localhost:3090/v1/auth
DOCS_SERVER_PROD_URL=https://api.farmx.in/v1/auth

# ── Services ──
GATEWAY_PORT=3090
GATEWAY_HOST_PORT=3090
HOST_PORT=3090
AUTH_SERVICE_URL=http://localhost:3001
MEDIA_SERVICE_URL=http://localhost:3002
MEDIA_SERVICE_PORT=3002
FARM_SERVICE_URL=http://localhost:3003
FARM_SERVICE_PORT=3003
CATALOG_SERVICE_URL=http://localhost:3004
CATALOG_SERVICE_PORT=3004
PRODUCT_SERVICE_URL=http://localhost:3005
PRODUCT_SERVICE_PORT=3005
# product-service reviews (D-49): window after delivery, edits per review, reports that auto-hide, banned words (comma list)
REVIEW_WINDOW_DAYS=180
REVIEW_MAX_EDITS=5
REVIEW_AUTO_HIDE_REPORTS=3
REVIEW_BANNED_WORDS=whatsapp,telegram,call me,contact me,dm me,cheaper at,buy from outside
ORDER_SERVICE_URL=http://localhost:3007
ORDER_SERVICE_PORT=3007
INVENTORY_SERVICE_URL=http://localhost:3008
INVENTORY_SERVICE_PORT=3008
PAYMENT_SERVICE_URL=http://localhost:3009
PAYMENT_SERVICE_PORT=3009
NOTIFICATION_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_PORT=3010
CALL_SERVICE_URL=http://localhost:3011
CALL_SERVICE_PORT=3011
WALLET_SERVICE_URL=http://localhost:3012
WALLET_SERVICE_PORT=3012
# warehouse-service (D-56): warehouse master, service areas, warehouse portal shell
WAREHOUSE_SERVICE_URL=http://localhost:3014
WAREHOUSE_SERVICE_PORT=3014
# Shared service-to-service token for /internal/* (≥ 32 chars; never routed by the gateway).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_TOKEN=

# ── farm-service (verifies tokens with JWT_PUBLIC_KEY above) ──
# PAN encryption: base64 of 32 random bytes. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required when APP_ENV=dev or prod (local runs use ephemeral keys, with a warning).
FARM_PII_ENC_KEY=
# HMAC secret (≥ 32 chars) for PAN lookup hashes and signed Farm-pass QR codes.
FARM_PII_HMAC_KEY=
# fake = Aadhaar OTP 123456 + any valid GSTIN is ACTIVE (refused in prod).
KYC_PROVIDER=fake
FARM_DOCS_SERVER_URL=http://localhost:3000/v1
DEDUPE_RADIUS_M=150
REVIEW_SLA_HOURS=4

# ── catalog-service (verifies tokens with JWT_PUBLIC_KEY above) ──
# Category tree guard rail: max levels (root = level 1).
CATALOG_MAX_CATEGORY_DEPTH=10

# ── auth-service seed (first Super Admin; remove the password after first run) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# ── payment-service (D-37) ──
# mock = dev / test bypass (no money moves); REFUSED when APP_ENV=prod (prod defaults to razorpay).
PAYMENT_PROVIDER=mock
# Razorpay dashboard → API keys / Webhooks (required when PAYMENT_PROVIDER=razorpay; never commit).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── notification-service (D-46; docs/notifications) ──
# Providers: console = log instead of send (dev; REFUSED when APP_ENV=prod), none = channel off
# (deliveries SKIPPED). Prod defaults: fcm, smtp, none (SMS provider not chosen yet).
PUSH_PROVIDER=console
# Firebase console → Project settings → Service accounts → Generate new private key; base64 the
# JSON: node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
FCM_SERVICE_ACCOUNT_JSON=
EMAIL_PROVIDER=console
# smtp(s)://user:pass@host:port (Amazon SES / Zoho / Gmail Workspace SMTP credentials)
SMTP_URL=
EMAIL_FROM=FarmX <no-reply@farmx.in>
SMS_PROVIDER=console
# Per provider call; attempts before a delivery is FAILED (backoff 30 s × 2^n, ±20 %, ≤ 1 h).
PROVIDER_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=6
# Parallel sends per replica / max sends per second across all replicas, per channel.
PUSH_CONCURRENCY=20
EMAIL_CONCURRENCY=5
SMS_CONCURRENCY=5
PUSH_RATE_PER_SEC=300
EMAIL_RATE_PER_SEC=10
SMS_RATE_PER_SEC=10
FANOUT_CONCURRENCY=4
NOTIFICATION_RETENTION_DAYS=180
# Prometheus /metrics on the service port (never routed by the gateway).
METRICS_ENABLED=1

# ── order-service invoices (D-48) — seller of record on GST tax documents ──
# Required in prod (outside prod an invoice cannot be issued until set). The GSTIN's state code
# must equal SELLER_STATE_CODE. Series are 1–3 letters (numbers like FX/2627/0000001, ≤ 16 chars).
SELLER_GSTIN=
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
INVOICE_SERIES=FX
CREDIT_NOTE_SERIES=CN
# Inter-state B2C invoices above this (₹) are reported as GSTR-1 B2CL.
B2CL_THRESHOLD=100000.00
# Invoice PDFs: spaces = DigitalOcean Spaces (PRIVATE objects, signed download URLs; reuses the
# AWS_* variables above); local = a directory (dev / tests only, refused when APP_ENV=prod).
INVOICE_STORAGE=local
INVOICE_LOCAL_DIR=.data/invoices
# Optional PNG / JPEG logo on invoices (else the seller name as a wordmark).
INVOICE_LOGO_PATH=
INVOICE_PDF_CONCURRENCY=2
INVOICE_PDF_MAX_ATTEMPTS=6

# ── call-service (D-53) ──
# mock = dev / test telephony (no real calls, no masking); REFUSED when APP_ENV=prod.
TELEPHONY_PROVIDER=mock
